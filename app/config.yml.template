config:
  # Required authentication.
  arl_token: "PASTE_ARL_HERE"
  user_id: "YOUR_NUMERIC_USER_ID" # Numeric ID from your profile URL

  # Optional: enables playlist metadata writes (rename, privacy, description).
  # Export the 'refresh-token' cookie from your browser alongside the ARL.
  # Without this, those operations will be skipped with a warning.
  # refresh_token: ""

  # Logging and visibility.
  log_level: "INFO" # DEBUG, INFO, WARNING, ERROR
  print_banner: true

  # API behavior. Leave these unless troubleshooting.
  chunk_size: 50
  api_batch_size: 50
  rate_limit: 60
  max_retries: 4

  # Deezer collection caps.
  playlist_cap: 5000
  favorites_cap: 10000

  # Advanced options (optional):
  # write_logs: true
  # retention: 0
  # file_retention: 168
  # run_before_cron: true
  # blocklist_expiry_days: 7
  # interleave_continue_on_exhaust: false  # Default for interleave inject/origin exhaustion behaviour. Env: DEEZER_INTERLEAVE_CONTINUE_ON_EXHAUST
