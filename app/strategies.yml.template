# Minimal startup template. See wiki for full reference examples.
# Advanced startup templates: templates/startup/strategies.comprehensive.yml
playlists:
  - name: "Artist Timeline"
    source:
      - type: "artist"
        id: "12246" # Example: Taylor Swift
    modifiers:
      - type: "sort"
        field: "release_date"
        order: "asc"
    destination:
      - type: "playlist"
        id: "REPLACE_WITH_YOUR_PLAYLIST_ID"
        order: "replace"

  - name: "Discovery Mix"
    source:
      - type: "smarttracklist"
        name: "discovery"
      - type: "favorites"
    modifiers:
      - type: "dedupe"
      - type: "shuffle"
        order: "smart"
      - type: "limit"
        count: 100
        order: "top"
    destination:
      - type: "playlist"
        id: "REPLACE_WITH_YOUR_PLAYLIST_ID"
        order: "replace"

  - name: "Track Quick Picks"
    source:
      - type: "track"
        id: ["1008610492", "1008610493"]
    modifiers:
      - type: "dedupe"
    destination:
      - type: "playlist"
        id: "REPLACE_WITH_YOUR_PLAYLIST_ID"
        order: "replace"
